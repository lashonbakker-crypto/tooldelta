{
  "tools": [
    {
      "name": "search_docs",
      "description": "Search the team knowledge base.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 3
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "mode": {
            "type": "string",
            "enum": [
              "hybrid",
              "keyword"
            ]
          },
          "tenant": {
            "type": "string"
          }
        },
        "required": [
          "query",
          "tenant"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "summarize_note",
      "description": "Create a summary preview.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true
      }
    },
    {
      "name": "list_spaces",
      "description": "List available spaces.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    }
  ]
}
